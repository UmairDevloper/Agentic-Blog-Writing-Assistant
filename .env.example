# Copy this file to .env and configure only the providers you enable.
# Keep real credentials in .env or your deployment secret manager.
SEO_BLOG_APP_ENV=development
SEO_BLOG_LOG_LEVEL=INFO

# Configure hosted open-source text inference. Replace placeholders.
SEO_BLOG_TEXT_MODEL_PROVIDER=groq
SEO_BLOG_TEXT_MODEL_NAME=openai/gpt-oss-20b
SEO_BLOG_GROQ_API_KEY=replace-with-your-groq-api-key
SEO_BLOG_TEXT_MODEL_MAX_CONCURRENCY=2
SEO_BLOG_TEXT_MODEL_MAX_ATTEMPTS=4
SEO_BLOG_TEXT_MODEL_MAX_COMPLETION_TOKENS=4096
# Low reasoning effort reduces reasoning-token usage for GPT-OSS models.
SEO_BLOG_TEXT_MODEL_REASONING_EFFORT=low
# Batched mode minimizes calls; per_section keeps concurrent section generation.
SEO_BLOG_WRITING_MODE=batched
SEO_BLOG_MAX_WORDS_PER_CALL=1500
# Maximum image prompts or generated illustrations per article (0 disables them).
SEO_BLOG_MAX_IMAGES=3
# placeholder leaves copyable prompt blocks; generate calls Hugging Face; off disables images.
SEO_BLOG_IMAGE_MODE=placeholder
# Optional request pacing; leave unset to disable.
# SEO_BLOG_TEXT_MODEL_REQUESTS_PER_SECOND=1

# Optional web research:
# SEO_BLOG_SEARCH_PROVIDER=tavily
# SEO_BLOG_SEARCH_API_KEY=replace-with-your-tavily-api-key
# SEO_BLOG_SEARCH_MAX_ATTEMPTS=3
# Category-aware query cap (default 2; range 1-3).
SEO_BLOG_SEARCH_QUERIES_PER_ARTICLE=2

# Optional Hugging Face Inference Providers image generation (no local GPU).
# Placeholder mode is the default and does not need these settings or a token.
# Free accounts receive about $0.10/month in shared provider credits.
# Keep image generation off unless needed; max is 3 per article by default.
# SEO_BLOG_IMAGE_PROVIDER=huggingface
# SEO_BLOG_IMAGE_MODEL_NAME=black-forest-labs/FLUX.1-schnell
# SEO_BLOG_IMAGE_INFERENCE_PROVIDER=auto
# SEO_BLOG_IMAGE_NUM_INFERENCE_STEPS=4
# SEO_BLOG_HUGGINGFACE_TOKEN=replace-with-your-huggingface-token
