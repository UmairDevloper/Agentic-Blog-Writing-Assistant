# Copy this file to .env and configure only the providers you enable.
# Keep real credentials in .env or your deployment secret manager.
SEO_BLOG_APP_ENV=development
SEO_BLOG_LOG_LEVEL=INFO

# Configure a hosted text model. Replace placeholders before running the app.
SEO_BLOG_TEXT_MODEL_PROVIDER=groq
SEO_BLOG_TEXT_MODEL_NAME=your-groq-model
SEO_BLOG_GROQ_API_KEY=replace-with-your-groq-api-key

# Optional web research:
# SEO_BLOG_SEARCH_PROVIDER=tavily
# SEO_BLOG_SEARCH_API_KEY=replace-with-your-tavily-api-key

# Optional hosted image generation (no local GPU required):
# SEO_BLOG_IMAGE_PROVIDER=huggingface
# Qwen/Qwen-Image is an example; confirm it is available through hosted inference.
# SEO_BLOG_IMAGE_MODEL_NAME=Qwen/Qwen-Image
# SEO_BLOG_HUGGINGFACE_TOKEN=replace-with-your-huggingface-token
